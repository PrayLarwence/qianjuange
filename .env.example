# 默认 Provider: claude | openai | deepseek | ollama
# 这些 .env 值仅在 data/llm_config.json 不存在时生效；
# 运行后请优先用 Web UI 右上角 ⚙ 配置面板修改。
LLM_PROVIDER=claude

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (OpenAI 兼容协议, base_url=https://api.deepseek.com/v1)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Ollama (本地, 默认 http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
